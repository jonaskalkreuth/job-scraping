# Secrets — real credentials must never be committed.
.env

# Scraped data — bulky, re-derivable, and possibly ToS-sensitive.
# We commit a small curated sample (data/sample/) instead; see below.
data/raw/
data/*.db
data/jobs.db

# Scheduler output. launchd throws stderr away, so run_weekly.sh appends both
# streams here; it is a local operational record, not repo content.
data/logs/

# Python runtime / build cruft.
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Jupyter notebook checkpoints.
.ipynb_checkpoints/

# OS noise.
.DS_Store
